{
  "name": "simple-reminder",
  "version": "1.0.0",
  "description": "Simple Reminder plugin for Obsidian — system notifications with interval, one-shot and scheduled types.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "obsidian",
    "reminder",
    "notification"
  ],
  "devDependencies": {
    "@types/node": "^20.0.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.21.5",
    "obsidian": "latest",
    "typescript": "^5.4.5",
    "vitest": "^4.1.6"
  }
}
